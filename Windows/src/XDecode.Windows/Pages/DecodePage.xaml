<Page
    x:Class="XDecode.WindowsApp.Pages.DecodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XDecode.WindowsApp">
    <Page.Resources>
        <local:DecodeStateConverter x:Key="DecodeStateConverter" />
    </Page.Resources>
    <Grid Padding="32" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="解密日志" Style="{StaticResource TitleTextBlockStyle}" />
        <Border Grid.Row="1" x:Name="DropTarget" AllowDrop="True"
                DragOver="DropTarget_DragOver" Drop="DropTarget_Drop"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2" CornerRadius="6" Padding="24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" />
                <TextBlock Text="拖入 Xlog、MX、Logan 或 ZIP" FontSize="18" />
                <Button Click="SelectFiles_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="选择文件" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="最近处理" Style="{StaticResource SubtitleTextBlockStyle}" />
        <ListView Grid.Row="3" x:Name="RecentList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding State, Converter={StaticResource DecodeStateConverter}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Request.SourcePath}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="定位" Tag="{Binding}" Click="Reveal_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
