<Page
    x:Class="XDecode.WindowsApp.Pages.DecodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XDecode.WindowsApp.Controls"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28" Spacing="22">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="解密日志" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="支持 Xlog、MX、Logan 和符合规则的 ZIP"
                               Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="SelectFiles_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="选择文件" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="DropTarget"
                    Height="180"
                    AllowDrop="True"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    DragOver="DropTarget_DragOver"
                    Drop="DropTarget_Drop">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <FontIcon Glyph="&#xE896;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="拖入日志或 ZIP 即可解密"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="可同时处理多个文件"
                               Style="{StaticResource PageSubtitleTextStyle}"
                               HorizontalAlignment="Center" />
                    <Button Content="浏览文件" Click="SelectFiles_Click" />
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="最近5个处理"
                           Style="{StaticResource SectionTitleTextStyle}"
                           VerticalAlignment="Center" />
                <HyperlinkButton Content="查看全部"
                                 HorizontalAlignment="Right"
                                 Click="ViewAll_Click" />
            </Grid>

            <Grid MinHeight="180">
                <StackPanel x:Name="EmptyRecent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="9">
                    <SymbolIcon Symbol="Clock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="暂无任务"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="解密结果会显示在这里"
                               Style="{StaticResource PageSubtitleTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="RecentList"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:ResultRow Result="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Padding="0,8,0,0">
                <TextBlock Text="单个日志解密成功后删除源文件；ZIP 批量始终保留源 ZIP"
                           Style="{StaticResource CaptionTextStyle}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="7"
                            HorizontalAlignment="Right">
                    <Ellipse Width="7" Height="7"
                             Fill="{ThemeResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="等待任务"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
