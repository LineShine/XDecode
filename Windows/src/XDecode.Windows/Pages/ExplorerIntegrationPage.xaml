<Page
    x:Class="XDecode.WindowsApp.Pages.ExplorerIntegrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28" Spacing="22">
            <StackPanel Spacing="4">
                <TextBlock Text="资源管理器右键" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="从文件的快捷菜单直接进入统一解密队列"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border MinHeight="250"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <FontIcon Glyph="&#xE7C3;"
                                  FontSize="54"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="sample.xlog" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M8.5,1 L10.1,6.4 L15.5,8 L10.1,9.6 L8.5,15 L6.9,9.6 L1.5,8 L6.9,6.4 Z M17.2,10.8 L18.2,14.1 L21.5,15.1 L18.2,16.1 L17.2,19.4 L16.2,16.1 L12.9,15.1 L16.2,14.1 Z M18.1,1.6 L18.8,3.9 L21.1,4.6 L18.8,5.3 L18.1,7.6 L17.4,5.3 L15.1,4.6 L17.4,3.9 Z" />
                        <TextBlock Text="使用 XDecode 解密" FontWeight="SemiBold" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="打开方式 → XDecode" />
                    </StackPanel>
                    <TextBlock Text="资源管理器扩展只转发受支持的普通文件；文件规则和密钥统一由 XDecode 主程序处理。"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="右键菜单支持 .xlog、.mx 和 .zip；打开方式仍支持 .logan"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
