<Page
    x:Class="XDecode.WindowsApp.Pages.ExplorerIntegrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28" Spacing="22">
            <StackPanel Spacing="4">
                <TextBlock Text="资源管理器右键" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="从文件的快捷菜单直接进入统一解密队列"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border MinHeight="250"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <FontIcon Glyph="&#xE7C3;"
                                  FontSize="54"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="sample.xlog" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="使用 XDecode 解密" FontWeight="SemiBold" />
                    </StackPanel>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="打开方式 → XDecode" />
                    </StackPanel>
                    <TextBlock Text="资源管理器扩展只转发普通文件；文件格式、规则和密钥统一由 XDecode 主程序处理。"
                               Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="支持 .xlog、.mx、.logan 和 .zip"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
