<Page
    x:Class="XDecode.WindowsApp.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28" Spacing="22" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="监控文件夹" Style="{StaticResource PageTitleTextStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="下载监听" Style="{StaticResource SectionTitleTextStyle}" />
                <Border Style="{StaticResource GroupedSectionStyle}">
                    <StackPanel>
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="自动解密" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1"
                                          x:Name="AutomaticToggle"
                                          OffContent=""
                                          OnContent=""
                                          Toggled="AutomaticToggle_Toggled" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="EmptyFolders"
                                   Text="尚未添加监控文件夹"
                                   Padding="16,14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="FolderList"
                                  SelectionMode="None"
                                  ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon Symbol="Folder"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Width="32" Height="32" Padding="0"
                                                Tag="{Binding}"
                                                Click="RemoveFolder_Click"
                                                ToolTipService.ToolTip="移除监控文件夹">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Button Margin="12,10"
                                HorizontalAlignment="Left"
                                Click="AddFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="添加监控文件夹" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <TextBlock Text="只处理开启监听后新增且符合设置规则的 Xlog、MX、日期格式 Logan 和 ZIP；文件稳定后才开始解密。"
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="处理规则" Style="{StaticResource SectionTitleTextStyle}" />
                <Border Style="{StaticResource GroupedSectionStyle}">
                    <StackPanel>
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="输出文件" />
                            <TextBlock Grid.Column="1" Text="原文件名.log" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ZIP 输出" />
                            <TextBlock Grid.Column="1" Text="ZIP 同名目录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="发生重名" />
                            <TextBlock Grid.Column="1" Text="自动追加 -1、-2…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="单个日志成功" />
                            <TextBlock Grid.Column="1" Text="永久删除源文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Padding="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ZIP 批量" />
                            <TextBlock Grid.Column="1" Text="始终保留源 ZIP" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
