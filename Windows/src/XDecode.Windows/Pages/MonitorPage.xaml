<Page
    x:Class="XDecode.WindowsApp.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="监控文件夹" Style="{StaticResource TitleTextBlockStyle}" />
        <ToggleSwitch Grid.Row="1" x:Name="AutomaticToggle" Header="自动解密"
                      Toggled="AutomaticToggle_Toggled" />
        <ListView Grid.Row="2" x:Name="FolderList" SelectionMode="Single" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Click="AddFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" /><TextBlock Text="添加" />
                </StackPanel>
            </Button>
            <Button Click="RemoveFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" /><TextBlock Text="移除" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
