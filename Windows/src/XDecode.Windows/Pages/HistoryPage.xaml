<Page
    x:Class="XDecode.WindowsApp.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XDecode.WindowsApp.Controls"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Grid Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="历史记录" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="列表显示最近 30 条，磁盘保留最近 200 条且不超过 30 天"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Click="Clear_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="清空记录" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="EmptyHistory"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="9">
                <SymbolIcon Symbol="Clock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="暂无历史记录"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <ListView x:Name="HistoryList"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:ResultRow Result="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
