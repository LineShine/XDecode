<Page
    x:Class="XDecode.WindowsApp.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XDecode.WindowsApp">
    <Page.Resources>
        <local:DecodeStateConverter x:Key="DecodeStateConverter" />
    </Page.Resources>
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="历史记录" Style="{StaticResource TitleTextBlockStyle}" />
            <Button HorizontalAlignment="Right" Click="Clear_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" /><TextBlock Text="清空" />
                </StackPanel>
            </Button>
        </Grid>
        <Grid Grid.Row="1" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="时间" />
            <TextBlock Grid.Column="1" Text="状态" />
            <TextBlock Grid.Column="2" Text="源文件" />
            <TextBlock Grid.Column="3" Text="结果" />
        </Grid>
        <ListView Grid.Row="2" x:Name="HistoryList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FinishedAt}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding State, Converter={StaticResource DecodeStateConverter}}" />
                        <TextBlock Grid.Column="2" Text="{Binding Request.SourcePath}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                        <Button Grid.Column="4" Content="定位" Tag="{Binding}" Click="Reveal_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
