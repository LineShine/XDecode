<UserControl
    x:Class="XDecode.WindowsApp.Controls.ResultRow"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XDecode.WindowsApp">
    <UserControl.Resources>
        <local:DecodeStateSymbolConverter x:Key="StateSymbolConverter" />
        <local:DecodeStateBrushConverter x:Key="StateBrushConverter" />
        <local:FileNameConverter x:Key="FileNameConverter" />
        <local:DecodeDurationTextConverter x:Key="DurationTextConverter" />
        <local:DecodeDurationBrushConverter x:Key="DurationBrushConverter" />
        <local:LogFormatConverter x:Key="FormatConverter" />
    </UserControl.Resources>

    <Grid DataContext="{x:Bind Result, Mode=OneWay}"
          MinHeight="64"
          Padding="8,10"
          ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>

        <SymbolIcon Symbol="{Binding State, Converter={StaticResource StateSymbolConverter}}"
                    Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Request.SourcePath, Converter={StaticResource FileNameConverter}}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock Text="{Binding Converter={StaticResource DurationTextConverter}}"
                           Foreground="{Binding Converter={StaticResource DurationBrushConverter}}"
                           FontSize="12" />
            </StackPanel>
            <TextBlock Text="{Binding Message}"
                       Style="{StaticResource CaptionTextStyle}"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   Text="{Binding Request.Format, Converter={StaticResource FormatConverter}}"
                   Style="{StaticResource CaptionTextStyle}"
                   VerticalAlignment="Center" />

        <Button Grid.Column="3"
                Width="32" Height="32"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="Reveal_Click"
                ToolTipService.ToolTip="在资源管理器中显示">
            <SymbolIcon Symbol="Folder" />
        </Button>
    </Grid>
</UserControl>
