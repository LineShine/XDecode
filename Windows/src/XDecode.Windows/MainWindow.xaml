<Window
    x:Class="XDecode.WindowsApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="XDecode">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <NavigationView x:Name="Navigation"
                        AlwaysShowHeader="False"
                        CompactPaneLength="54"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="False"
                        OpenPaneLength="210"
                        PaneDisplayMode="Left"
                        Loaded="Navigation_Loaded"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="解密" Tag="decode">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M8.5,1 L10.1,6.4 L15.5,8 L10.1,9.6 L8.5,15 L6.9,9.6 L1.5,8 L6.9,6.4 Z M17.2,10.8 L18.2,14.1 L21.5,15.1 L18.2,16.1 L17.2,19.4 L16.2,16.1 L12.9,15.1 L16.2,14.1 Z M18.1,1.6 L18.8,3.9 L21.1,4.6 L18.8,5.3 L18.1,7.6 L17.4,5.3 L15.1,4.6 L17.4,3.9 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="历史记录" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="监控文件夹" Tag="monitor">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="资源管理器右键" Tag="explorer">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M9.25,2 C9.66421,2 10,2.33579 10,2.75 L10,5.25 C10,5.66421 9.66421,6 9.25,6 C8.83579,6 8.5,5.66421 8.5,5.25 L8.5,2.75 C8.5,2.33579 8.83579,2 9.25,2 Z M4.46965,3.96981 C4.76253,3.67691 5.23741,3.67689 5.53031,3.96977 L7.28031,5.71965 C7.57322,6.01253 7.57323,6.48741 7.28035,6.78031 C6.98747,7.07322 6.51259,7.07323 6.21969,6.78035 L4.46969,5.03047 C4.17678,4.73759 4.17677,4.26271 4.46965,3.96981 Z M14.0303,3.96979 C14.3232,4.26269 14.3232,4.73756 14.0303,5.03045 L12.2803,6.78045 C11.9874,7.07335 11.5126,7.07335 11.2197,6.78045 C10.9268,6.48756 10.9268,6.01269 11.2197,5.71979 L12.9697,3.96979 C13.2626,3.6769 13.7374,3.6769 14.0303,3.96979 Z M2.5,8.75 C2.5,8.33579 2.83579,8 3.25,8 L5.75,8 C6.16421,8 6.5,8.33579 6.5,8.75 C6.5,9.16421 6.16421,9.5 5.75,9.5 L3.25,9.5 C2.83579,9.5 2.5,9.16421 2.5,8.75 Z M10.6773,8.48562 C9.82176,7.75227 8.5,8.36019 8.5,9.48706 L8.5,20.7608 C8.5,21.9715 9.99462,22.5426 10.8019,21.6403 L13.4165,18.7181 C13.6918,18.4104 14.0801,18.2274 14.4927,18.2109 L18.3327,18.0573 C19.5304,18.0094 20.0484,16.518 19.1384,15.7379 L10.6773,8.48562 Z M10,20.287 L10,9.88067 L17.8123,16.5769 L14.4327,16.7121 C13.6146,16.7448 12.8446,17.1077 12.2986,17.7179 L10,20.287 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Grid Height="42">
                    <Grid x:Name="AutomationCompactStatus"
                          Width="54"
                          HorizontalAlignment="Left"
                          Visibility="Collapsed">
                        <Ellipse Width="8" Height="8"
                                 Fill="#168447"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="AutomationExpandedStatus"
                          Padding="14,0"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8"
                                 Fill="#168447"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   Text="自动解密运行中"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"
                        Click="AddLogs_Click"
                        ToolTipService.ToolTip="添加日志">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="添加日志" />
                    </StackPanel>
                </Button>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
